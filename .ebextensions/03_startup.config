files:
  "/etc/systemd/system/election.service":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Election Backend
      After=network.target
      [Service]
      User=root
      ExecStartPre=/usr/bin/aws s3 cp s3://elasticbeanstalk-ap-south-1-821279529027/application_linux /var/app/current/election_backend
      ExecStartPre=/bin/chmod +x /var/app/current/election_backend
      ExecStartPre=/bin/bash -c 'mkdir -p /etc/nginx/conf.d && echo "server { listen 80; location / { proxy_pass http://127.0.0.1:5000; proxy_http_version 1.1; proxy_set_header Host \$host; proxy_set_header X-Real-IP \$remote_addr; } }" > /etc/nginx/conf.d/election.conf'
      ExecStartPre=/bin/sed -i "s/    server {/#   server {/" /etc/nginx/nginx.conf
      ExecStartPre=/bin/systemctl restart nginx
      WorkingDirectory=/var/app/current
      Environment="PORT=5000"
      Environment="DB_HOST=awseb-e-2ta8uv25be-stack-awsebrdsdatabase-w9njndnukqjm.c12wueweo2b2.ap-south-1.rds.amazonaws.com"
      Environment="DB_PORT=5432"
      Environment="DB_NAME=ebdb"
      Environment="DB_USER=postgres"
      Environment="DB_PASS=kumbh1234"
      Environment="DB_SSLMODE=require"
      ExecStart=/var/app/current/election_backend
      Restart=always
      RestartSec=5
      [Install]
      WantedBy=multi-user.target

container_commands:
  01_enable_election:
    command: "systemctl daemon-reload && systemctl enable election && systemctl start election || true"
  02_enable_nginx:
    command: "systemctl enable nginx && systemctl start nginx || true"